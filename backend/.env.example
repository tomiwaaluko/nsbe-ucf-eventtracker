# PRIMARY: Supabase Postgres (source of truth for Member/Event/Attendance/Friends/Points).
# Use the same Supabase project as Auth (JWT / SUPABASE_URL).
DATABASE_URL="postgresql://<user>:<password>@<supabase-pooler-host>:6543/postgres?pgbouncer=true&schema=public"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# BACKUP ONLY: Railway Postgres. Keep the service; do not use as primary except DR.
# After cutover, primary→backup upserts run on an interval (see BACKUP_SYNC_INTERVAL_MS).
# Run `npm run db:sync-backup` once after switching primary to seed the backup.
BACKUP_DATABASE_URL="postgresql://<user>:<password>@<railway-postgres-host>:5432/railway"
# Optional. Minimum 30000. Default 300000 (5 minutes).
BACKUP_SYNC_INTERVAL_MS=""

# Disaster recovery only. If true, allows Railway as DATABASE_URL primary.
# Never leave this set in normal staging/production operation.
ALLOW_RAILWAY_PRIMARY=""

SUPABASE_JWT_SECRET="<your-supabase-jwt-secret>"
PORT=4000

# OAuth Providers
GOOGLE_CLIENT_ID="<your-google-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/oauth/google/callback"

DISCORD_CLIENT_ID="<your-discord-client-id>"
DISCORD_CLIENT_SECRET="<your-discord-client-secret>"
DISCORD_REDIRECT_URI="http://localhost:4000/api/auth/oauth/discord/callback"

# Application URLs
APP_BASE_URL="http://localhost:3000"
OAUTH_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"  # Used for password reset email redirects


API_KEY=""

# Optional: Supabase Admin (for creating users in Supabase Auth)
SUPABASE_URL="<your-supabase-url>"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"

# Comma-separated list of allowed frontend origins for CORS.
# REQUIRED in production - the app refuses to start without it.
# Previously this was a regex allowing every *.vercel.app and *.railway.app
# origin on the internet, combined with credentials: true.
# Example: https://nsbeucf.org,https://www.nsbeucf.org
CORS_ORIGINS=""
