DATABASE_URL="postgresql://<user>:<password>@<supabase-host>:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
SUPABASE_JWT_SECRET="<your-supabase-jwt-secret>"
PORT=4000

# OAuth Providers
GOOGLE_CLIENT_ID="<your-google-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-client-secret>"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/oauth/google/callback"

DISCORD_CLIENT_ID="<your-discord-client-id>"
DISCORD_CLIENT_SECRET="<your-discord-client-secret>"
DISCORD_REDIRECT_URI="http://localhost:4000/api/auth/oauth/discord/callback"

# Application URLs
APP_BASE_URL="http://localhost:3000"
OAUTH_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"  # Used for password reset email redirects


API_KEY=""

# Optional: Supabase Admin (for creating users in Supabase Auth)
SUPABASE_URL="<your-supabase-url>"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"
