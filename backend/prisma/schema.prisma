generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Member {
  id                       String          @id @default(uuid())
  email                    String          @unique
  firstName                String?
  lastName                 String?
  role                     String          @default("member")
  createdAt                DateTime        @default(now())
  emailVerified            Boolean         @default(false)
  passwordHash             String?
  updatedAt                DateTime        @updatedAt
  isActive                 Boolean         @default(true)
  bio                      String?
  discordUsername          String?
  graduationYear           Int?
  linkedInUrl              String?
  major                    String?
  phoneNumber              String?
  photoUrl                 String?
  chapterDuesSelfReported  Boolean         @default(false)
  nationalDuesSelfReported Boolean         @default(false)
  chapterDuesReportedAt    DateTime?
  nationalDuesReportedAt   DateTime?
  attendance               Attendance[]
  eventsCreated            Event[]
  oauthAccounts            OAuthAccount[]
  eventInterests           EventInterest[]
  friendOf                 Friendship[]    @relation("FriendFriendships")
  friendships              Friendship[]    @relation("UserFriendships")
  pointEntries             PointEntry[]    @relation("MemberPointEntries")
  awardedPointEntries      PointEntry[]    @relation("AwardedByAdmin")

  @@index([email])
}

model Event {
  id             String          @id @default(uuid())
  name           String
  description    String?
  category       EventCategory
  semester       String
  startTime      DateTime
  endTime        DateTime
  location       String?
  qrSecret       String
  isActive       Boolean         @default(true)
  createdById    String?
  checkInCode    String?         @unique
  attendance     Attendance[]
  createdBy      Member?         @relation(fields: [createdById], references: [id])
  eventInterests EventInterest[]
}

model Attendance {
  id            String   @id @default(uuid())
  memberId      String
  eventId       String
  checkedInAt   DateTime @default(now())
  checkInMethod String   @default("qr")
  event         Event    @relation(fields: [eventId], references: [id])
  member        Member   @relation(fields: [memberId], references: [id])

  @@unique([memberId, eventId])
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  providerEmail  String?
  emailVerified  Boolean  @default(false)
  accessToken    String?
  refreshToken   String?
  scopes         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           Member   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([provider, providerEmail])
}

model Friendship {
  id          String           @id @default(uuid())
  userId      String
  friendId    String
  status      FriendshipStatus @default(PENDING)
  requesterId String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  friend      Member           @relation("FriendFriendships", fields: [friendId], references: [id], onDelete: Cascade)
  user        Member           @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId, status])
  @@index([friendId, status])
  @@index([requesterId])
  @@map("friendships")
}

model EventInterest {
  id        String              @id @default(uuid())
  memberId  String
  eventId   String
  status    EventInterestStatus @default(PLANNING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member    Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@index([eventId, status])
  @@index([memberId, status])
  @@map("event_interests")
}

enum EventCategory {
  GBM
  SOCIAL
  WORKSHOP
  FUNDRAISER
  COMMUNITY_SERVICE
  COMMITTEE_PARTICIPATION
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum EventInterestStatus {
  PLANNING
  CANCELLED
  ATTENDED
}

model PointEntry {
  id       String @id @default(uuid())
  memberId String
  member   Member @relation("MemberPointEntries", fields: [memberId], references: [id])

  pointTypeKey String
  points       Int
  semester     String
  label        String?
  note         String?

  awardedById String
  awardedBy   Member   @relation("AwardedByAdmin", fields: [awardedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([memberId, pointTypeKey, label, semester])
  @@index([memberId, semester])
  @@index([semester])
}
