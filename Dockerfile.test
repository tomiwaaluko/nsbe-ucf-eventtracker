FROM node:20.11.1-alpine

WORKDIR /app

# Set a placeholder DATABASE_URL for build time
ENV DATABASE_URL="postgresql://placeholder:placeholder@placeholder:5432/placeholder?schema=public"

# Copy the entire project
COPY . .

# Install dependencies (mimics Railway's nixpacks behavior)
RUN cd backend && npm install

# Generate Prisma client
RUN cd backend && npx prisma generate

# Build the application
RUN cd backend && npm run build

# Start command
CMD ["sh", "-c", "cd backend && npm run start:prod"]
